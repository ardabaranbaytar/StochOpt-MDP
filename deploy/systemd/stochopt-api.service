# FastAPI backend, reachable only through Caddy (bound to localhost).
# Installed by deploy/setup_vps.sh.
[Unit]
Description=StochOpt-MDP API (FastAPI / uvicorn)
Wants=network-online.target
After=network-online.target

[Service]
User=stochopt
WorkingDirectory=/opt/stochopt-mdp
# Shared 2-vCPU server: one solver/simulation at a time, extra requests wait.
Environment=STOCHOPT_MAX_JOBS=1
Environment=XDG_CACHE_HOME=/opt/stochopt-mdp/.cache
ExecStart=/opt/stochopt-mdp/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8100 --proxy-headers
Restart=on-failure
RestartSec=5
# Hardening: the app only needs to write its cache.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stochopt-mdp/.cache

[Install]
WantedBy=multi-user.target
